# ===== Ren'Py / DDLC BrokenDreamsModTemplate =====

# --- Bytecode y cache (se regeneran solos) ---
*.rpyc
*.rpyb
*.pyc
__pycache__/
game/cache/

# --- Datos de partida y persistentes (locales del jugador) ---
game/saves/
*.save

# --- Assets oficiales de DDLC (los aporta el modder; NO se versionan) ---
game/*.rpa

# --- Logs y reportes de errores ---
log.txt
errors.txt
traceback.txt
game/log.txt
game/errors.txt
game/traceback.txt

# --- Temporales de Ren'Py ---
*.bak
*~

# --- Sistema operativo / editor ---
thumbs.db
Desktop.ini
.DS_Store
*.sublime-workspace
*.sublime-project
# La config de editor vive solo en la raíz; ignora duplicados dentro de game/.
game/.vscode/

# --- Instrucciones locales para agentes (solo en tu copia, no se versiona) ---
AGENTS.md

# --- Empaquetado ---
/dist/

# --- Sistema de migración de assets ---
# El manifest se genera en cada release (no se commitea).
game/migracion/manifest.json
game/migracion/.job.json
game/migracion/.template.zip
game/migracion/manual.zip
game/migracion/reporte.json
game/migracion/migracion.log
# Respaldos de la migración (van en la raíz, fuera de game/).
migracion_backup/
