# ===== Ren'Py / DDLC DokifileModTemplate =====

# --- Bytecode y cache (se regeneran solos) ---
*.rpyc
*.rpyb
*.pyc
__pycache__/
game/cache/

# --- Datos de partida y persistentes (locales del jugador) ---
game/saves/
*.save

# --- Carpeta de personajes generada en runtime desde game/chrs/ ---
/characters/

# --- Logs y reportes de errores ---
log.txt
errors.txt
traceback.txt
game/log.txt
game/errors.txt
game/traceback.txt

# --- Temporales de Ren'Py ---
*.bak
*~

# --- Sistema operativo / editor ---
thumbs.db
Desktop.ini
.DS_Store
*.sublime-workspace
*.sublime-project

# --- Empaquetado ---
/dist/
